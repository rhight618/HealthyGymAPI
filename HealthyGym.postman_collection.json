				{
					"name": "newCheckIn",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"//get iteration and userList variables\r",
									"var currentIter = parseInt(pm.collectionVariables.get(\"iterCount\"));\r",
									"var totalUsers = parseInt(pm.collectionVariables.get(\"totalUsers\"));\r",
									"var userListMaxSize = parseInt(pm.collectionVariables.get(\"userListMaxSize\"));\r",
									"\r",
									"var userList;\r",
									"if(currentIter == 0){\r",
									"    userList = [];\r",
									"}else{\r",
									"    userList = pm.collectionVariables.get(\"UserList\");\r",
									"}\r",
									"\r",
									"if(userList.length == userListMaxSize){\r",
									"    console.log(\"Resetting user list\");\r",
									"    userList = [];\r",
									"}\r",
									"\r",
									"currentIter = currentIter + 1;\r",
									"pm.collectionVariables.set(\"iterCount\", currentIter);\r",
									"\r",
									"//get a new userId that hasnt been used already\r",
									"var userId = 0;\r",
									"let fLen = userList.length;\r",
									"let keepLooping = true;\r",
									"let userExists = false;\r",
									"\r",
									"while(keepLooping){\r",
									"    userExists = false;\r",
									"    userId = Math.floor(Math.random() * totalUsers) + 1;\r",
									"    for (let i = 0; i < fLen; i++) {\r",
									"        //console.log(\"Newly generated userId: \" + userId);\r",
									"        //console.log(\"Existing userId from list: \" + userList[i]);\r",
									"        if(userList[i] == userId){ \r",
									"            //console.log(\"user id exists in list\");\r",
									"            userExists=true;\r",
									"        }   \r",
									"    }\r",
									"\r",
									"    if(!userExists){\r",
									"        keepLooping=false;\r",
									"        userList.push(userId);\r",
									"    }\r",
									"\r",
									"}\r",
									"\r",
									"var day = parseInt(pm.collectionVariables.get(\"day\"));\r",
									"\r",
									"//console.log(\"Current Iter : \" + currentIter + \" % 40 = Modulus: \" + currentIter % 40);\r",
									"\r",
									"var currentMod = currentIter % 40;\r",
									"\r",
									"if(currentMod == 0){\r",
									"    day = day + 1\r",
									"}\r",
									"\r",
									"var dayString = (day.toString().length > 1)? day.toString() : \"0\" + day;\r",
									"//console.log(dayString);\r",
									"\r",
									"var morning = 40 * .20;\r",
									"var noon = 40 * .40;\r",
									"var evening = 40 * 1;\r",
									"\r",
									"var checkin_timestamp;\r",
									"if(currentMod <= morning){\r",
									"    checkin_timestamp = \"2021-10-\"+ dayString + \" 06:00:00\"; \r",
									"}else if(currentMod > morning && currentMod <= noon){\r",
									"    checkin_timestamp = \"2021-10-\"+ dayString + \" 12:00:00\"; \r",
									"}else{\r",
									"    checkin_timestamp = \"2021-10-\"+ dayString + \" 18:00:00\"; \r",
									"}\r",
									"\r",
									"pm.collectionVariables.set(\"User\", userId);\r",
									"pm.collectionVariables.set(\"UserList\", userList);\r",
									"pm.collectionVariables.set(\"day\", day);\r",
									"pm.collectionVariables.set(\"Checkin_TS\", checkin_timestamp);\r",
									""
								],
								"type": "text/javascript"
							}
						},
